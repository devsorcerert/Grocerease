# ==============================================================
# GrocerEase Frontend - Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your values.
# Expo automatically loads variables prefixed with EXPO_PUBLIC_
# NEVER commit your actual .env file to version control!
# ==============================================================

# --- Backend API URLs ---
# The base URL of your deployed FastAPI backend service
EXPO_PUBLIC_API_URL=https://your-backend-url.com
EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.com

# --- Google OAuth 2.0 Client IDs ---
# Set up at: https://console.cloud.google.com/
# Web Client ID (used for browser/web OAuth flows)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
# Android Client ID (requires SHA-1 fingerprint registered in Google Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
# iOS Client ID (requires iOS URL scheme in app.json)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com

# --- Razorpay Payment Configuration ---
# Get your keys from: https://dashboard.razorpay.com/
# Use rzp_test_ prefix for test mode, rzp_live_ for production
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY

# --- Emergent Social Auth Configuration (Fallback / Web OAuth) ---
# Used for web-based OAuth redirect flows
EXPO_PUBLIC_EMERGENT_AUTH_URL=https://auth.emergentagent.com/
EXPO_PUBLIC_EMERGENT_SESSION_URL=https://demobackend.emergentagent.com/auth/v1/env/oauth/session-data

# ==============================================================
# LOCAL DEVELOPMENT SETUP:
# 1. cp frontend/.env.example frontend/.env
# 2. Fill in all values above
# 3. For backend, cp .env.example .env at the repo root
# 4. Run: cd frontend && npx expo start
# ==============================================================
