# ============================================================
# GrocerEase Frontend - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# Expo automatically loads variables prefixed with EXPO_PUBLIC_
# NEVER commit your actual .env file to version control!
# ============================================================

# --- Backend API URLs ---
# The base URL of your deployed FastAPI backend service
# Replace with your actual backend domain before building.
EXPO_PUBLIC_API_URL=https://api.grocereasetv.com
EXPO_PUBLIC_BACKEND_URL=https://api.grocereasetv.com
EXPO_PUBLIC_DEV_BACKEND_URL=http://localhost:8001

# --- Google OAuth 2.0 Client IDs ---
# Google Cloud Project: GrocerEase (grocerease-499205)
# Project Number: 418665414188
# Set up at: https://console.cloud.google.com/auth/clients?project=grocerease-499205

# Web Client ID (used for browser/web OAuth flows)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=418665414188-rl2jg740eersokldgp9ojnr6ue7uvc0r.apps.googleusercontent.com

# Android Client ID (used for Android Google Sign-In)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=418665414188-mdmkg84jnujtmr3nvhkop74ifp78nr9k.apps.googleusercontent.com

# iOS Client ID (requires iOS URL scheme in app.json)
# iOS URL Scheme: com.googleusercontent.apps.418665414188-3teeuukmq7m66m5lra36mc6be32i1n2f
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=418665414188-3teeuukmq7m66m5lra36mc6be32i1n2f.apps.googleusercontent.com

# --- Razorpay ---
# Get from: https://dashboard.razorpay.com/app/keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY

# --- Firebase ---
# Firebase Project: grocerease-499205
# Get Android API key from: Firebase Console > Project Settings > General
# android > App > google-services.json > api_key > current_key
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_ANDROID_API_KEY
