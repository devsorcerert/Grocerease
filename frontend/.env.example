# ============================================================
# GrocerEase Frontend — Environment Variables Template
# Copy this file to .env and fill in your values.
# Expo automatically loads variables prefixed with EXPO_PUBLIC_
# ============================================================

# --- Backend API URL ---
# The URL of your deployed backend service (FastAPI)
EXPO_PUBLIC_BACKEND_URL=https://order-management-93.preview.emergentagent.com

# --- Google OAuth 2.0 Client IDs ---
# Set up in Google Cloud Console: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=517781079379-nkg71u5h723qbeab81005a96l0r2u4tq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=517781079379-8pll85b985h98b7p5h6j9h5h72j2.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=517781079379-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Razorpay Payment Configuration ---
# Your Razorpay Test/Live Key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY

# --- Emergent Social Auth Configuration (Fallback / Web) ---
# Redirect URLs for Web/Browser OAuth processes
EXPO_PUBLIC_EMERGENT_AUTH_URL=https://auth.emergentagent.com/
EXPO_PUBLIC_EMERGENT_SESSION_URL=https://demobackend.emergentagent.com/auth/v1/env/oauth/session-data
