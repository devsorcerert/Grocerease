# ============================================================
# GrocerEase — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- MongoDB ---
# Get from https://cloud.mongodb.com → Connect → Drivers
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/grocerease?retryWrites=true&w=majority

# --- JWT ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-here

# --- Razorpay ---
# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- SMS / OTP ---
# Fast2SMS (cheapest for India): https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_key_here
# OR use MSG91: https://msg91.com
# MSG91_AUTH_KEY=your_msg91_key
# MSG91_TEMPLATE_ID=your_template_id

# --- Admin Panel ---
ADMIN_SECRET_KEY=your-admin-secret-key-here

# --- Optional: Push Notifications ---
# Get from Firebase Console → Project Settings → Cloud Messaging
FIREBASE_SERVER_KEY=your_firebase_server_key_here
