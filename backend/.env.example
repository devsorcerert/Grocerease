# ============================================================
# GrocerEase Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# ============================================================

# --- MongoDB connection URL ---
# Local database format: mongodb://localhost:27017/grocerease
# Cloud Atlas database format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/grocerease?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=grocerease

# --- JWT Signing Secret ---
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- Razorpay Payment Configuration ---
# Get these keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# --- SMS Gateway (Fast2SMS) ---
# Your Fast2SMS API Key from https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here
